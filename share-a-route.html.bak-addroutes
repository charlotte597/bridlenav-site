<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Share a route with BridleNav</title>
<meta name="description" content="Already mapped your rides? Send the file and the detail, and we'll add the route to BridleNav.">
<!-- Deliberately not indexed. The address is given to contributors directly,
     which keeps the open submit form off the end of a search result. -->
<meta name="robots" content="noindex,nofollow">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap">
<link rel="stylesheet" href="css/site.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">

<style>
  /* Page-only styles. site.css has no form rules, and this is the only page
     with a form on it, so they live here rather than in the shared sheet. */
  .step{border-top:1px solid var(--rule);padding-block:30px}
  .step[hidden]{display:none}
  .step > .num{font-family:var(--display);font-size:.68rem;font-weight:700;
    letter-spacing:.14em;text-transform:uppercase;color:var(--gold-ink);display:block;margin-bottom:8px}
  .step h2{font-size:clamp(1.3rem,2.6vw,1.75rem);margin-bottom:10px}
  .step .help{color:var(--ink-soft);font-size:1rem;max-width:40rem;margin-bottom:20px}
  .step .help + .help{margin-top:-10px}

  .field{margin-bottom:18px;max-width:40rem}
  .field label{font-family:var(--display);font-weight:700;font-size:.9rem;
    display:block;margin-bottom:6px}
  .field .sub{color:var(--ink-soft);font-size:.9rem;margin-bottom:8px}
  input[type=text],input[type=email],textarea,select{
    width:100%;font-family:var(--body);font-size:1rem;color:var(--ink);
    background:var(--raised);border:1px solid var(--rule);border-radius:3px;
    padding:11px 13px;line-height:1.45}
  textarea{min-height:110px;resize:vertical}
  input:focus-visible,textarea:focus-visible,select:focus-visible{
    outline:2px solid var(--gold);outline-offset:1px}

  .choices{display:flex;flex-wrap:wrap;gap:8px}
  .choices button{font-family:var(--display);font-size:.88rem;font-weight:600;
    background:var(--raised);color:var(--ink-soft);border:1px solid var(--rule);
    border-radius:2px;padding:9px 15px;cursor:pointer}
  .choices button[aria-pressed=true]{background:var(--green);border-color:var(--green);color:#F6F2E6}

  #map{height:clamp(260px,46vw,430px);border:1px solid var(--rule);border-radius:3px;
    background:var(--raised);margin-bottom:16px}
  .leaflet-container{font-family:var(--body)}
  .pin{display:flex;align-items:center;justify-content:center;
    width:24px;height:24px;border-radius:50%;background:var(--gold);color:#16211A;
    font-family:var(--display);font-weight:800;font-size:.72rem;
    border:2px solid #16211A;box-shadow:0 1px 3px rgba(0,0,0,.4)}
  .pin.off{background:#9A988F;opacity:.55}

  .stat{font-family:var(--display);font-weight:700;font-size:.95rem;color:var(--ink-soft)}
  .stat b{color:var(--ink);font-size:1.3rem;font-variant-numeric:tabular-nums}

  .drop{border:2px dashed var(--rule);border-radius:4px;background:var(--raised);
    padding:34px 20px;text-align:center;cursor:pointer}
  .drop.over{border-color:var(--gold);background:var(--ground)}
  .drop p{color:var(--ink-soft);font-size:.98rem}
  .drop .big{font-family:var(--display);font-weight:700;font-size:1.06rem;color:var(--ink);margin-bottom:6px}

  .slider{margin-bottom:14px}
  .slider label{font-family:var(--display);font-weight:700;font-size:.86rem;display:block;margin-bottom:4px}
  input[type=range]{width:100%;accent-color:var(--green)}

  .turn{display:grid;grid-template-columns:7.5rem 1fr;gap:8px 14px;
    padding:14px 0;border-bottom:1px solid var(--rule);align-items:start}
  .turn .where{font-family:var(--display);font-weight:700;font-size:.86rem;color:var(--ink-soft);padding-top:9px}
  .turn .where i{display:block;font-style:normal;font-weight:600;font-size:.78rem;color:var(--gold-ink)}
  .turn .ctrls{display:flex;flex-wrap:wrap;gap:8px}
  .turn select{width:auto;min-width:9rem;flex:none}
  .turn input[type=text]{flex:1;min-width:12rem}
  .turn .drop-it{font-family:var(--display);font-size:.8rem;font-weight:700;
    background:none;border:none;color:var(--ink-soft);cursor:pointer;
    text-decoration:underline;padding:0 4px}
  .turn.gone{opacity:.42}
  @media (max-width:640px){.turn{grid-template-columns:1fr}.turn .where{padding-top:0}}

  .pics{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
  .pic{position:relative;width:118px;height:118px;border-radius:3px;overflow:hidden;border:1px solid var(--rule)}
  .pic img{width:100%;height:100%;object-fit:cover;display:block}
  .pic button{position:absolute;top:3px;right:3px;width:24px;height:24px;border-radius:50%;
    border:none;background:rgba(13,20,15,.78);color:#F6F2E6;font-size:14px;cursor:pointer;line-height:1}

  .tickrow{display:flex;gap:13px;align-items:flex-start;cursor:pointer;
    border:1px solid var(--rule);border-radius:3px;background:var(--raised);
    padding:16px;max-width:40rem}
  .tickrow.on{border-color:var(--green);border-width:2px;padding:15px}
  .box{flex:none;width:24px;height:24px;border:2px solid var(--rule);border-radius:3px;
    display:flex;align-items:center;justify-content:center;font-weight:800;color:transparent;margin-top:1px}
  .tickrow.on .box{background:var(--green);border-color:var(--green);color:#F6F2E6}
  .tickrow span.words{font-size:.99rem;line-height:1.5}

  .send{font-family:var(--display);font-weight:700;font-size:1rem;
    background:var(--green);color:#F6F2E6;border:1px solid var(--green);
    padding:15px 30px;border-radius:3px;cursor:pointer}
  .send[disabled]{background:var(--rule);border-color:var(--rule);color:var(--ink-soft);cursor:not-allowed}

  .say{margin-top:14px;font-size:.98rem;color:var(--ink-soft);max-width:40rem}
  .say.bad{color:#9C3D2B}
  :root:not([data-theme="light"]) .say.bad{color:#E79080}
  @media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .say.bad{color:#E79080}}

  .done{border:2px solid var(--green);border-radius:4px;background:var(--raised);
    padding:clamp(24px,4vw,38px);max-width:40rem}
  .done h2{margin-bottom:12px}
  .done p{color:var(--ink-soft);margin-bottom:12px}

  /* Bots fill in every field they can see. People never see this one. */
  .nope{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
</style>
</head>
<body>

<header class="masthead">
  <div class="wrap">
    <a class="mark" href="index.html">Bridle<span>Nav</span></a>
    <nav class="nav">
      <a href="how-it-works.html">How it works</a>
      <a href="routes.html">Routes</a>
      <a href="safety.html">Safety</a>
      <a href="faq.html">FAQ</a>
      <a href="about.html">About</a>
    </nav>
  </div>
</header>

<section>
  <div class="wrap">
    <span class="eyebrow">For riders who already map their rides</span>
    <h1 style="margin-block:14px 18px">Share a route</h1>
    <p class="help measure" style="font-size:1.1rem">
      If you have already mapped your rides &mdash; in Footpath, OS Maps, on a Garmin, or anything
      else that gives you a GPX file &mdash; you do not need to ride them again. Send the file here
      with what you know about the route, and it will come through to be checked and added.
    </p>
    <p class="help measure" style="margin-top:14px">
      It takes about ten minutes for the first one and rather less after that. Nothing is published
      until it has been read through by a person.
    </p>
  </div>
</section>

<div class="wrap">
<form id="form" autocomplete="on">

<!-- ------------------------------------------------------------------ 1 -->
<div class="step" id="s1">
  <span class="num">Step one</span>
  <h2>Your file</h2>
  <p class="help">
    A GPX file, exported from whatever you plan your rides in. Most apps call it
    &ldquo;Export GPX&rdquo; or &ldquo;Share &rarr; GPX&rdquo;. Nothing leaves this page until you press send at the bottom.
  </p>

  <div class="drop" id="drop">
    <p class="big">Choose a GPX file</p>
    <p>or drag one onto this box</p>
  </div>
  <!-- Deliberately OUTSIDE the drop box. A programmatic .click() on a file
       input bubbles, so an input inside the box would re-trigger the box's
       own click handler and spin forever. -->
  <input type="file" id="file" accept=".gpx,application/gpx+xml,text/xml" style="display:none">
  <p class="say" id="filesay"></p>
</div>

<!-- ------------------------------------------------------------------ 2 -->
<div class="step" id="s2" hidden>
  <span class="num">Step two</span>
  <h2>Where it starts and finishes</h2>
  <p class="help">
    Most recorded rides start at your own yard. Sharing that whole line puts your home on a
    public map and tells other riders there is parking at your gate, so drag the start forward
    to the first place somebody else could sensibly box up and get on.
  </p>
  <p class="help">
    Whatever you cut off never leaves this page. If the file already starts somewhere public,
    leave both handles where they are.
  </p>

  <div id="map"></div>

  <div class="slider">
    <label for="trimA">Start the shared route here</label>
    <input type="range" id="trimA" min="0" value="0">
  </div>
  <div class="slider">
    <label for="trimB">Finish it here</label>
    <input type="range" id="trimB" min="0" value="0">
  </div>
  <p class="stat" id="trimsay"></p>
</div>

<!-- ------------------------------------------------------------------ 3 -->
<div class="step" id="s3" hidden>
  <span class="num">Step three</span>
  <h2>What BridleNav should say</h2>
  <p class="help">
    These are the places your line changed direction. The firm ones are listed ready for you to
    write; the shallow bends start set aside, because most of those are just the path winding
    through trees rather than somewhere a rider needs telling. Nothing is hidden &mdash; if one of the
    set-aside ones is really a junction, put it back.
  </p>
  <p class="help">
    Whatever you write here is <strong>spoken out loud</strong> to the rider as they approach it, so write it
    the way you would say it to somebody riding behind you. &ldquo;Left through the gate by the barn&rdquo;
    beats &ldquo;turn left&rdquo;. You can also mark gates, water and livestock, and those need no words at all.
  </p>

  <div id="turns"></div>

  <p style="margin-top:18px">
    <button type="button" class="store alt" id="addpt"
            style="color:var(--ink);border-color:var(--rule)">Add a point by tapping the map</button>
  </p>
  <p class="say" id="turnsay"></p>
</div>

<!-- ------------------------------------------------------------------ 4 -->
<div class="step" id="s4" hidden>
  <span class="num">Step four</span>
  <h2>About the route</h2>

  <div class="field">
    <label for="name">What is it called?</label>
    <p class="sub">How a rider would describe it to a friend. &ldquo;Langsett barn circular&rdquo;, not &ldquo;Ride 4&rdquo;.</p>
    <input type="text" id="name" maxlength="90" required>
  </div>

  <div class="field">
    <label for="region">Where is it?</label>
    <p class="sub">The nearest place somebody would recognise &mdash; &ldquo;Durham&rdquo;, or &ldquo;Langsett, near Sheffield&rdquo;.</p>
    <input type="text" id="region" maxlength="80">
  </div>

  <div class="field">
    <label>How hard is it?</label>
    <div class="choices" id="difficulty">
      <button type="button" data-v="easy" aria-pressed="false">Easy</button>
      <button type="button" data-v="moderate" aria-pressed="false">Moderate</button>
      <button type="button" data-v="challenging" aria-pressed="false">Challenging</button>
    </div>
  </div>

  <div class="field">
    <label>Are there roads on it?</label>
    <p class="sub">Riders with a nervous horse filter on this, so it matters that it is right.</p>
    <div class="choices" id="traffic">
      <button type="button" data-v="none" aria-pressed="false">No roads at all</button>
      <button type="button" data-v="quiet" aria-pressed="false">Quiet lanes</button>
      <button type="button" data-v="busy" aria-pressed="false">Busy roads</button>
    </div>
  </div>

  <div class="field">
    <label>Is it a hack or a day out?</label>
    <p class="sub">A hack goes from a yard or a lane end and takes an hour or two. A day out is one you box up for.</p>
    <div class="choices" id="routeType">
      <button type="button" data-v="hack" aria-pressed="false">A hack</button>
      <button type="button" data-v="day_out" aria-pressed="false">A day out</button>
    </div>
  </div>

  <div class="field">
    <label for="notes">Anything riders should know?</label>
    <p class="sub">Going underfoot, whether it dries out, gates that are stiff, where it gets busy with walkers, anything you would mention in the lorry park.</p>
    <textarea id="notes" maxlength="1200"></textarea>
  </div>
</div>

<!-- ------------------------------------------------------------------ 5 -->
<div class="step" id="s5" hidden>
  <span class="num">Step five</span>
  <h2>Parking</h2>
  <p class="help">
    This is the part riders thank you for. A postcode often drops somebody towing a lorry at the
    wrong end of a long lane.
  </p>

  <div class="field">
    <label for="parking">Where do you park?</label>
    <p class="sub">Name it, say what the surface is like, and say whether it costs anything.</p>
    <textarea id="parking" maxlength="700" style="min-height:92px"></textarea>
  </div>

  <div class="field">
    <label for="w3w">The what3words square for it</label>
    <p class="sub">Three words with dots between, like <em>///egging.escalates.upstarts</em>. Open the what3words app where you park and copy what it says.</p>
    <input type="text" id="w3w" maxlength="80" placeholder="///word.word.word">
  </div>

  <div class="field">
    <label>What can get in?</label>
    <div class="choices" id="fits">
      <button type="button" data-v="Car" aria-pressed="false">Car</button>
      <button type="button" data-v="Car and trailer" aria-pressed="false">Car and trailer</button>
      <button type="button" data-v="Lorry" aria-pressed="false">Lorry</button>
    </div>
  </div>
</div>

<!-- ------------------------------------------------------------------ 6 -->
<div class="step" id="s6" hidden>
  <span class="num">Step six</span>
  <h2>Two or three photographs</h2>
  <p class="help">
    Two is the minimum. They are what makes another rider pick your route over somebody else's,
    so a view, the going underfoot and the parking are worth more than three of the same gate.
  </p>
  <p class="help">
    They are shrunk here in your browser before they are sent, which also strips the location
    tag the camera put in them.
  </p>

  <p>
    <button type="button" class="store alt" id="addpic"
            style="color:var(--ink);border-color:var(--rule)">Choose photographs</button>
    <input type="file" id="pics" accept="image/*" multiple style="display:none">
  </p>
  <div class="pics" id="picstrip"></div>
  <p class="say" id="picsay"></p>
</div>

<!-- ------------------------------------------------------------------ 7 -->
<div class="step" id="s7" hidden>
  <span class="num">Step seven</span>
  <h2>You</h2>

  <div class="field">
    <label for="who">Your name on the route</label>
    <p class="sub">Shown to riders as the person who found it. Leave it blank if you would rather not be named.</p>
    <input type="text" id="who" maxlength="70">
  </div>

  <div class="field">
    <label for="contact">An email address</label>
    <p class="sub">Only used to come back to you with a question about this route. It is never shown to riders.</p>
    <input type="email" id="contact" maxlength="120">
  </div>

  <div class="nope" aria-hidden="true">
    <label for="website">Leave this empty</label>
    <input type="text" id="website" tabindex="-1" autocomplete="off">
  </div>

  <div class="tickrow" id="tick" role="checkbox" aria-checked="false" tabindex="0">
    <span class="box">&#10003;</span>
    <span class="words">
      Any rider could follow this route &mdash; it&rsquo;s all public bridleway, byway, road or path
      open to everyone. None of it relies on permission given to me personally.
    </span>
  </div>

  <p style="margin-top:28px">
    <button type="submit" class="send" id="send">Send it for review</button>
  </p>
  <p class="say" id="sendsay"></p>
</div>

</form>

<div class="step" id="thanks" hidden style="border-top:none">
  <div class="done">
    <h2>Thank you &mdash; that has come through</h2>
    <p>
      Your route is now sitting with us to be read through. We check where it goes before anything
      is published, so it may be a day or two.
    </p>
    <p>
      If there is a question about it, we will come back to you on the address you gave.
    </p>
    <p style="margin-bottom:0">
      <a class="more" href="share-a-route.html">Send another one</a>
    </p>
  </div>
</div>
</div>

<footer>
  <div class="wrap">
    <div>
      <div class="mark" style="color:#F6F2E6;margin-bottom:10px">Bridle<span>Nav</span></div>
      <p class="legal">
        BridleNav is published by BridleNav Limited, registered in England and Wales,
        company number 17461028. Registered office: Acorn Business Park,
        7 Commercial Gate, Mansfield, NG18 1EX.
      </p>
      <p class="legal" style="margin-top:12px">
        Always ride within your ability and your horse&rsquo;s. BridleNav guides you along a
        route; it does not judge whether that route is safe on the day.
      </p>
    </div>
    <div class="flinks">
      <a href="mailto:hello@bridlenav.com">hello@bridlenav.com</a>
      <a href="terms.html">Terms of Service</a>
      <a href="privacy.html">Privacy Policy</a>
    </div>
  </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<script>
(function () {
  'use strict';

  // --------------------------------------------------------------------
  // The database this lands in is the SAME one the app submits to, with the
  // same open insert policy and the same trigger on the other end. So a route
  // sent from here produces exactly the notification email a route sent from a
  // phone produces, and is approved on the same page. Nothing here is special.
  // --------------------------------------------------------------------
  var SB  = 'https://xlvjhktfaiagtbdxaetn.supabase.co';
  var KEY = 'sb_publishable_OYjxynX2htU7Z5BAC0lcUg_kqqt1mo_';
  var BUCKET = 'route-photos';
  var TARGET_POINTS = 150;   // same as the app: lib/simplifyLine.ts
  var MIN_PHOTOS = 2, MAX_PHOTOS = 3, MAX_EDGE = 1600, QUALITY = 0.72;

  var $ = function (id) { return document.getElementById(id); };

  // ====================================================================
  // GEOMETRY - ported straight from the app so a route sent from here is
  // identical in shape to one recorded on a phone. Do not "improve" these
  // without changing lib/simplifyLine.ts and lib/ridePoints.ts to match.
  // ====================================================================
  var R = 6371000;
  function rad(d) { return d * Math.PI / 180; }

  function metresBetween(a, b) {           // points are [lon, lat]
    var p1 = rad(a[1]), p2 = rad(b[1]);
    var dp = rad(b[1] - a[1]), dl = rad(b[0] - a[0]);
    var h = Math.sin(dp / 2) * Math.sin(dp / 2) +
            Math.cos(p1) * Math.cos(p2) * Math.sin(dl / 2) * Math.sin(dl / 2);
    return 2 * R * Math.asin(Math.min(1, Math.sqrt(h)));
  }

  function bearing(a, b) {
    var p1 = rad(a[1]), p2 = rad(b[1]), dl = rad(b[0] - a[0]);
    var y = Math.sin(dl) * Math.cos(p2);
    var x = Math.cos(p1) * Math.sin(p2) - Math.sin(p1) * Math.cos(p2) * Math.cos(dl);
    return Math.atan2(y, x) * 180 / Math.PI;
  }

  function cumulative(track) {
    var out = [0], i;
    for (i = 1; i < track.length; i++) out.push(out[i - 1] + metresBetween(track[i - 1], track[i]));
    return out;
  }

  function perpendicularDistance(p, a, b) {
    var dx = b[0] - a[0], dy = b[1] - a[1];
    if (dx === 0 && dy === 0) return Math.hypot(p[0] - a[0], p[1] - a[1]);
    var t = ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / (dx * dx + dy * dy);
    var c = Math.max(0, Math.min(1, t));
    return Math.hypot(p[0] - (a[0] + c * dx), p[1] - (a[1] + c * dy));
  }

  function douglasPeucker(points, tol) {
    if (points.length < 3) return points.slice();
    var maxD = 0, index = 0, first = points[0], last = points[points.length - 1], i, d;
    for (i = 1; i < points.length - 1; i++) {
      d = perpendicularDistance(points[i], first, last);
      if (d > maxD) { maxD = d; index = i; }
    }
    if (maxD <= tol) return [first, last];
    var left = douglasPeucker(points.slice(0, index + 1), tol);
    var right = douglasPeucker(points.slice(index), tol);
    return left.slice(0, -1).concat(right);
  }

  function thinLine(line, target) {
    target = target || TARGET_POINTS;
    if (!line || line.length <= target) return (line || []).slice();
    var midLat = line[Math.floor(line.length / 2)][1];
    var kx = Math.cos(midLat * Math.PI / 180);
    var scaled = line.map(function (p) { return [p[0] * kx, p[1]]; });
    var lo = 0, hi = 0.02, best = scaled, i, mid, out;
    for (i = 0; i < 18; i++) {
      mid = (lo + hi) / 2;
      out = douglasPeucker(scaled, mid);
      if (out.length > target) { lo = mid; } else { best = out; hi = mid; }
    }
    return best.map(function (p) { return [p[0] / kx, p[1]]; });
  }

  function words(deg) {
    var a = Math.abs(deg), side = deg < 0 ? 'left' : 'right';
    if (a >= 100) return 'hairpin ' + side;
    if (a >= 70)  return 'sharp ' + side;
    if (a >= 45)  return side;
    return 'bears ' + side;
  }

  // minDegrees is deliberately low. An extra suggestion costs one tap to throw
  // away; a junction never offered costs a rider their way.
  function detectTurns(track, minDegrees, minSegment) {
    minDegrees = minDegrees || 30; minSegment = minSegment || 20;
    if (!track || track.length < 3) return [];
    var cum = cumulative(track), out = [], i, change;
    for (i = 1; i < track.length - 1; i++) {
      if (metresBetween(track[i - 1], track[i]) < minSegment) continue;
      if (metresBetween(track[i], track[i + 1]) < minSegment) continue;
      change = bearing(track[i], track[i + 1]) - bearing(track[i - 1], track[i]);
      while (change > 180) change -= 360;
      while (change < -180) change += 360;
      if (Math.abs(change) < minDegrees) continue;
      out.push({
        index: i, lat: track[i][1], lon: track[i][0],
        meters: Math.round(cum[i]), degrees: Math.round(change),
        direction: change < 0 ? 'left' : 'right', hint: words(change)
      });
    }
    return out;
  }

  function alongRide(m) {
    var miles = m / 1609.34;
    if (miles < 0.1) return 'at the start';
    return miles.toFixed(1) + ' miles in';
  }

  function normaliseW3W(raw) {
    var t = (raw || '').trim().replace(/^\/+/, '').toLowerCase();
    if (!t) return null;
    var m = t.match(/^([^.\s\/]+)\.([^.\s\/]+)\.([^.\s\/]+)$/);
    return m ? '///' + m[1] + '.' + m[2] + '.' + m[3] : null;
  }

  function miles(m) { return (m / 1609.34).toFixed(1); }

  // ====================================================================
  // STATE
  // ====================================================================
  var full = [];        // the whole thinned line from the file
  var marks = [];       // {index, kind, note, dropped}
  var photos = [];      // {blob, url}
  var picks = { difficulty: '', traffic: '', routeType: '', fits: [] };
  var ticked = false;
  var adding = false;
  var map = null, lineOn = null, lineOff = null, pins = [];

  function trimA() { return parseInt($('trimA').value, 10) || 0; }
  function trimB() { return parseInt($('trimB').value, 10) || 0; }
  function shared() { return full.slice(trimA(), trimB() + 1); }

  // ====================================================================
  // STEP ONE - the file
  // ====================================================================
  function readGpx(text) {
    var doc = new DOMParser().parseFromString(text, 'application/xml');
    if (doc.getElementsByTagName('parsererror').length) return null;
    var nodes = doc.getElementsByTagName('trkpt');
    if (!nodes.length) nodes = doc.getElementsByTagName('rtept');
    if (!nodes.length) nodes = doc.getElementsByTagName('wpt');
    var out = [], i, lat, lon;
    for (i = 0; i < nodes.length; i++) {
      lat = parseFloat(nodes[i].getAttribute('lat'));
      lon = parseFloat(nodes[i].getAttribute('lon'));
      if (isFinite(lat) && isFinite(lon) && Math.abs(lat) <= 90 && Math.abs(lon) <= 180) {
        out.push([lon, lat]);
      }
    }
    return out;
  }

  function takeFile(file) {
    var say = $('filesay');
    say.className = 'say';
    if (!file) return;
    if (file.size > 12 * 1024 * 1024) {
      say.className = 'say bad';
      say.textContent = 'That file is very large. Most GPX files are well under a megabyte - is it definitely a single ride?';
      return;
    }
    var fr = new FileReader();
    fr.onerror = function () {
      say.className = 'say bad';
      say.textContent = 'That file could not be read. Try exporting it again.';
    };
    fr.onload = function () {
      var raw = readGpx(String(fr.result || ''));
      if (!raw) {
        say.className = 'say bad';
        say.textContent = 'That does not look like a GPX file. Most apps call the option "Export GPX".';
        return;
      }
      if (raw.length < 2) {
        say.className = 'say bad';
        say.textContent = 'There is no track in that file - only ' + raw.length + ' point. It may be a saved place rather than a ride.';
        return;
      }
      // Kept at FULL density. The app detects turns on the recorded track and
      // only thins on the way out, and the order matters: thinning first drops
      // the points between corners, which makes every corner that survives look
      // sharper than it is. Done the wrong way round, a 6-mile ride offered 61
      // turns instead of a couple of dozen. Thinning happens at send.
      full = raw;
      var total = cumulative(full)[full.length - 1];
      say.textContent = file.name + ' - ' + miles(total) + ' miles, from ' + raw.length +
                        ' recorded points. Scroll on for the next bit.';
      // The sections are revealed BEFORE the map is built. Leaflet measures its
      // container when it is created, and a container inside a hidden section
      // measures zero - which leaves a grey box and a fitBounds that throws.
      ['s2', 's3', 's4', 's5', 's6', 's7'].forEach(function (id) { $(id).hidden = false; });
      startTrim();
      buildTurns();
      if (map) map.invalidateSize();
      $('s2').scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    fr.readAsText(file);
  }

  $('drop').addEventListener('click', function () { $('file').click(); });
  $('file').addEventListener('change', function (e) { takeFile(e.target.files[0]); });
  ['dragenter', 'dragover'].forEach(function (ev) {
    $('drop').addEventListener(ev, function (e) { e.preventDefault(); $('drop').classList.add('over'); });
  });
  ['dragleave', 'drop'].forEach(function (ev) {
    $('drop').addEventListener(ev, function (e) { e.preventDefault(); $('drop').classList.remove('over'); });
  });
  $('drop').addEventListener('drop', function (e) {
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) takeFile(e.dataTransfer.files[0]);
  });

  // ====================================================================
  // THE MAP
  // ====================================================================
  function ensureMap() {
    if (map) return;
    map = L.map('map', { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);
    map.on('click', function (e) {
      if (!adding) return;
      adding = false;
      $('addpt').textContent = 'Add a point by tapping the map';
      addMarkAt(nearestIndex(e.latlng.lng, e.latlng.lat));
    });
  }

  function nearestIndex(lon, lat) {
    var best = trimA(), bestD = Infinity, i, d;
    for (i = trimA(); i <= trimB(); i++) {
      d = metresBetween(full[i], [lon, lat]);
      if (d < bestD) { bestD = d; best = i; }
    }
    return best;
  }

  function latlngs(part) { return part.map(function (p) { return [p[1], p[0]]; }); }

  function drawMap(fit) {
    ensureMap();
    if (lineOff) map.removeLayer(lineOff);
    if (lineOn) map.removeLayer(lineOn);
    lineOff = L.polyline(latlngs(full), { color: '#9A988F', weight: 3, opacity: 0.5, dashArray: '5,6' }).addTo(map);
    lineOn = L.polyline(latlngs(shared()), { color: '#4A6741', weight: 5 }).addTo(map);
    drawPins();
    if (fit) map.fitBounds(lineOff.getBounds(), { padding: [24, 24] });
  }

  function drawPins() {
    pins.forEach(function (p) { map.removeLayer(p); });
    pins = [];
    var n = 0;
    marks.forEach(function (m, i) {
      if (m.index < trimA() || m.index > trimB()) return;
      var live = !m.dropped;
      if (live) n++;
      var icon = L.divIcon({
        className: '', iconSize: [24, 24], iconAnchor: [12, 12],
        html: '<div class="pin' + (live ? '' : ' off') + '">' + (live ? n : '&middot;') + '</div>'
      });
      var mk = L.marker([full[m.index][1], full[m.index][0]], { icon: icon }).addTo(map);
      mk.on('click', function () {
        var row = $('turnrow' + i);
        if (row) row.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
      pins.push(mk);
    });
  }

  // ====================================================================
  // STEP TWO - the trim
  // ====================================================================
  function startTrim() {
    var a = $('trimA'), b = $('trimB');
    a.max = String(full.length - 1); b.max = String(full.length - 1);
    a.value = '0'; b.value = String(full.length - 1);
    drawMap(true);
    sayTrim();
  }

  function sayTrim() {
    var part = shared();
    var total = part.length > 1 ? cumulative(part)[part.length - 1] : 0;
    var cut = full.length - part.length;
    $('trimsay').innerHTML = 'Sharing <b>' + miles(total) + '</b> miles' +
      (cut > 0 ? ' &mdash; ' + cut + ' of ' + full.length + ' points trimmed off the ends' : ' &mdash; the whole line');
    drawMap(false);
    renderTurns();
  }

  $('trimA').addEventListener('input', function () {
    if (trimA() >= trimB()) $('trimA').value = String(Math.max(0, trimB() - 1));
    sayTrim();
  });
  $('trimB').addEventListener('input', function () {
    if (trimB() <= trimA()) $('trimB').value = String(Math.min(full.length - 1, trimA() + 1));
    sayTrim();
  });

  // ====================================================================
  // STEP THREE - the turns
  // ====================================================================
  var KINDS = [
    ['turn', 'A turn'],
    ['gate', 'A gate'],
    ['water', 'Water'],
    ['livestock', 'Livestock'],
    ['care', 'Take care']
  ];

  // Everything words() can produce. Used to tell OUR guess apart from words the
  // rider wrote, so only the guess is ever thrown away.
  var AUTO_WORDS = ['left', 'right', 'sharp left', 'sharp right',
                    'hairpin left', 'hairpin right', 'bears left', 'bears right'];

  // Re-label the rows and the running total in place. Used when a row changes
  // state mid-typing, where a full re-render would take the focus out of the
  // box the rider is in the middle of.
  function renumber() {
    var n = 0, shown = 0;
    marks.forEach(function (m, i) {
      if (m.index < trimA() || m.index > trimB()) return;
      shown++;
      if (!m.dropped) n++;
      var row = $('turnrow' + i);
      if (!row) return;
      var tag = row.querySelector('.where i');
      if (tag) tag.textContent = m.dropped ? 'not used' : 'point ' + n;
    });
    var aside = shown - n;
    $('turnsay').textContent = n + ' point' + (n === 1 ? '' : 's') + ' will go with the route' +
      (aside ? ', and ' + aside + ' set aside as probably just the path winding. Put any of those back if it is really a junction.' : '.');
  }

  var WANT_LIVE = 28;   // turns to write before it stops feeling like a form
  var MAX_ROWS = 150;   // rows on the page before it stops being readable at all

  function buildTurns() {
    // ALWAYS detected at the app's own sensitivity. The threshold is never
    // raised to shorten the list, because raising it genuinely loses junctions
    // and the rider would never know. What changes is only which ones start
    // SET ASIDE - still on the page, one tap from being put back.
    var found = detectTurns(full, 30);

    var firm = found.map(function (t) { return Math.abs(t.degrees); })
                    .sort(function (a, b) { return b - a; });
    if (found.length > MAX_ROWS) {
      var floor = firm[MAX_ROWS - 1];
      found = found.filter(function (t) { return Math.abs(t.degrees) >= floor; }).slice(0, MAX_ROWS);
    }
    // A shallow bend is usually the path winding rather than somewhere a rider
    // needs telling, so the cut-off is chosen to leave a sensible number live -
    // the firmest turns first, and never below 45 degrees.
    var cut = 45;
    if (firm.length > WANT_LIVE) cut = Math.max(45, firm[WANT_LIVE - 1]);

    marks = found.map(function (t) {
      return {
        index: t.index, kind: 'turn', note: t.hint,
        dropped: Math.abs(t.degrees) < cut
      };
    });
    renderTurns();
  }

  function addMarkAt(index) {
    marks.push({ index: index, kind: 'gate', note: '', dropped: false });
    marks.sort(function (x, y) { return x.index - y.index; });
    renderTurns();
  }

  function renderTurns() {
    var host = $('turns');
    var cum = cumulative(full);
    var base = cum[trimA()];
    host.innerHTML = '';
    var shown = 0, n = 0;

    marks.forEach(function (m, i) {
      if (m.index < trimA() || m.index > trimB()) return;   // trimmed away
      shown++;
      if (!m.dropped) n++;

      var row = document.createElement('div');
      row.className = 'turn' + (m.dropped ? ' gone' : '');
      row.id = 'turnrow' + i;

      var where = document.createElement('div');
      where.className = 'where';
      where.innerHTML = alongRide(Math.max(0, cum[m.index] - base)) +
                        '<i>' + (m.dropped ? 'not used' : 'point ' + n) + '</i>';

      var ctrls = document.createElement('div');
      ctrls.className = 'ctrls';

      var sel = document.createElement('select');
      KINDS.forEach(function (k) {
        var o = document.createElement('option');
        o.value = k[0]; o.textContent = k[1];
        if (k[0] === m.kind) o.selected = true;
        sel.appendChild(o);
      });
      sel.addEventListener('change', function () {
        // The words in the box were OUR guess at a turn ("sharp left"). Once
        // this is a gate or a water crossing that guess is wrong, and left
        // sitting there it would be read out at the gate. Anything the rider
        // typed themselves is left alone.
        if (sel.value !== 'turn' && AUTO_WORDS.indexOf((m.note || '').trim()) >= 0) m.note = '';
        m.kind = sel.value;
        renderTurns();
      });

      var txt = document.createElement('input');
      txt.type = 'text';
      txt.maxLength = 400;
      txt.value = m.note || '';
      txt.placeholder = m.kind === 'turn'
        ? 'Left through the gate by the barn'
        : 'Anything worth saying (optional)';
      txt.addEventListener('input', function () {
        m.note = txt.value;
        // Somebody who has bothered to write the words for a point wants that
        // point. Putting it back by hand afterwards is a step nobody would
        // think to take, and the words would go quietly nowhere.
        // Done WITHOUT a re-render, or the box loses focus mid-word.
        if (m.dropped && txt.value.trim() !== '') {
          m.dropped = false;
          row.classList.remove('gone');
          kill.textContent = 'not needed';
          renumber();
          if (map) drawPins();
        }
      });

      var kill = document.createElement('button');
      kill.type = 'button';
      kill.className = 'drop-it';
      kill.textContent = m.dropped ? 'put back' : 'not needed';
      kill.addEventListener('click', function () { m.dropped = !m.dropped; renderTurns(); });

      ctrls.appendChild(sel);
      ctrls.appendChild(txt);
      ctrls.appendChild(kill);
      row.appendChild(where);
      row.appendChild(ctrls);
      host.appendChild(row);
    });

    if (!shown) {
      host.innerHTML = '<p class="help" style="margin:0">Nothing was spotted on this line, which happens on a route that ' +
        'runs more or less straight. Use the button below to add the gates and turns yourself.</p>';
    }
    var aside = shown - n;
    $('turnsay').textContent = n + ' point' + (n === 1 ? '' : 's') + ' will go with the route' +
      (aside ? ', and ' + aside + ' set aside as probably just the path winding. Put any of those back if it is really a junction.' : '.');
    if (map) drawPins();
  }

  $('addpt').addEventListener('click', function () {
    adding = !adding;
    $('addpt').textContent = adding ? 'Now tap the map where it goes' : 'Add a point by tapping the map';
    if (adding) $('map').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  // ====================================================================
  // STEPS FOUR AND FIVE - the chips
  // ====================================================================
  function wireChoices(id, multi) {
    var host = $(id);
    host.addEventListener('click', function (e) {
      var b = e.target.closest('button');
      if (!b) return;
      var v = b.getAttribute('data-v');
      if (multi) {
        var at = picks.fits.indexOf(v);
        if (at >= 0) picks.fits.splice(at, 1); else picks.fits.push(v);
        b.setAttribute('aria-pressed', at >= 0 ? 'false' : 'true');
      } else {
        picks[id] = (picks[id] === v) ? '' : v;
        Array.prototype.forEach.call(host.querySelectorAll('button'), function (x) {
          x.setAttribute('aria-pressed', x.getAttribute('data-v') === picks[id] ? 'true' : 'false');
        });
      }
    });
  }
  wireChoices('difficulty', false);
  wireChoices('traffic', false);
  wireChoices('routeType', false);
  wireChoices('fits', true);

  // ====================================================================
  // STEP SIX - photographs
  // ====================================================================
  // Shrunk here rather than on the way out, for the same two reasons the app
  // does it: it is kinder to the sender's upload, and re-drawing through a
  // canvas throws away the EXIF block - which matters, because a photo taken
  // in a yard carries that yard's position and these go out to everyone.
  function shrink(file) {
    return new Promise(function (resolve) {
      var img = new Image();
      var url = URL.createObjectURL(file);
      img.onload = function () {
        var w = img.naturalWidth, h = img.naturalHeight, scale = 1;
        if (Math.max(w, h) > MAX_EDGE) scale = MAX_EDGE / Math.max(w, h);
        var c = document.createElement('canvas');
        c.width = Math.round(w * scale); c.height = Math.round(h * scale);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(url);
        c.toBlob(function (blob) { resolve(blob); }, 'image/jpeg', QUALITY);
      };
      img.onerror = function () { URL.revokeObjectURL(url); resolve(null); };
      img.src = url;
    });
  }

  function drawPics() {
    var strip = $('picstrip');
    strip.innerHTML = '';
    photos.forEach(function (p, i) {
      var d = document.createElement('div');
      d.className = 'pic';
      var im = document.createElement('img'); im.src = p.url; im.alt = '';
      var x = document.createElement('button');
      x.type = 'button'; x.innerHTML = '&times;'; x.title = 'Remove';
      x.addEventListener('click', function () {
        URL.revokeObjectURL(p.url); photos.splice(i, 1); drawPics();
      });
      d.appendChild(im); d.appendChild(x); strip.appendChild(d);
    });
    var say = $('picsay');
    say.className = 'say';
    if (photos.length < MIN_PHOTOS) {
      say.textContent = photos.length === 0
        ? 'Two photographs are needed before a route can be sent.'
        : 'One more needed.';
    } else {
      say.textContent = photos.length + ' ready.';
    }
    $('addpic').style.display = photos.length >= MAX_PHOTOS ? 'none' : '';
  }

  $('addpic').addEventListener('click', function () { $('pics').click(); });
  $('pics').addEventListener('change', function (e) {
    var files = Array.prototype.slice.call(e.target.files || []);
    var room = MAX_PHOTOS - photos.length;
    var take = files.slice(0, Math.max(0, room));
    $('picsay').className = 'say';
    $('picsay').textContent = 'Shrinking...';
    Promise.all(take.map(shrink)).then(function (blobs) {
      blobs.forEach(function (b) {
        if (b) photos.push({ blob: b, url: URL.createObjectURL(b) });
      });
      drawPics();
      if (files.length > room) {
        $('picsay').textContent = photos.length + ' ready. Three is the most that can go with a route.';
      }
    });
    e.target.value = '';
  });
  drawPics();

  // ====================================================================
  // STEP SEVEN - the tick
  // ====================================================================
  function toggleTick() {
    ticked = !ticked;
    $('tick').classList.toggle('on', ticked);
    $('tick').setAttribute('aria-checked', ticked ? 'true' : 'false');
  }
  $('tick').addEventListener('click', toggleTick);
  $('tick').addEventListener('keydown', function (e) {
    if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggleTick(); }
  });

  // ====================================================================
  // SEND
  // ====================================================================
  function headers(extra) {
    var h = { apikey: KEY, Authorization: 'Bearer ' + KEY };
    Object.keys(extra || {}).forEach(function (k) { h[k] = extra[k]; });
    return h;
  }

  function uploadPhoto(blob) {
    var name = 'web-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10) + '.jpg';
    return fetch(SB + '/storage/v1/object/' + BUCKET + '/' + name, {
      method: 'POST',
      headers: headers({ 'Content-Type': 'image/jpeg', 'x-upsert': 'false' }),
      body: blob
    }).then(function (r) {
      if (!r.ok) throw new Error('photo');
      return SB + '/storage/v1/object/public/' + BUCKET + '/' + name;
    });
  }

  function collectPoints() {
    var cum = cumulative(full), base = cum[trimA()];
    return marks
      .filter(function (m) { return !m.dropped && m.index >= trimA() && m.index <= trimB(); })
      .map(function (m) {
        return {
          lat: full[m.index][1],
          lon: full[m.index][0],
          meters: Math.max(0, Math.round(cum[m.index] - base)),
          kind: m.kind,
          note: (m.note || '').trim().slice(0, 400) || undefined
        };
      })
      .sort(function (a, b) { return a.meters - b.meters; });
  }

  function problem(msg) {
    var say = $('sendsay');
    say.className = 'say bad';
    say.textContent = msg;
    $('send').disabled = false;
    $('send').textContent = 'Send it for review';
    return false;
  }

  $('form').addEventListener('submit', function (e) {
    e.preventDefault();
    var say = $('sendsay');
    say.className = 'say';

    // A bot filled in the field nobody can see. Say nothing, do nothing.
    if ($('website').value.trim() !== '') { $('thanks').hidden = false; $('form').hidden = true; return; }

    if (full.length < 2) return problem('There is no route yet - choose a GPX file at the top.');
    if (!$('name').value.trim()) return problem('The route needs a name.');
    if (!picks.traffic) return problem('Please say whether there are roads on it. Riders filter on that, and leaving it blank hides your route from them.');
    if (photos.length < MIN_PHOTOS) return problem('Two photographs are needed before a route can be sent.');
    if (!ticked) {
      return problem('Please confirm any rider could follow this route. Permission given to you personally does not pass to the strangers who will ride it on your word - if any part of this needs that, it cannot be shared.');
    }

    $('send').disabled = true;
    $('send').textContent = 'Sending...';
    say.textContent = 'Sending the photographs...';

    Promise.all(photos.map(function (p) { return uploadPhoto(p.blob); }))
      .then(function (urls) {
        say.textContent = 'Sending the route...';
        var w3w = normaliseW3W($('w3w').value);
        var row = {
          name: $('name').value.trim(),
          region: $('region').value.trim() || null,
          difficulty: picks.difficulty || null,
          parking: $('parking').value.trim() || null,
          notes: $('notes').value.trim() || null,
          // Thinned here, on the way out, exactly as the app does it. The line
          // the rider worked on was the full one; what gets stored is 150
          // points, which is all a map needs and a fraction of the size.
          track: thinLine(shared(), TARGET_POINTS),
          points: collectPoints(),
          photos: urls,
          traffic: picks.traffic || null,
          route_type: picks.routeType || null,
          rights_confirmed_at: new Date().toISOString(),
          submitter_name: $('who').value.trim() || null,
          submitter_contact: $('contact').value.trim() || null,
          device_id: 'web-form',
          status: 'pending'
        };
        if (w3w) row.parking_w3w = w3w;
        if (picks.fits.length) row.parking_fits = picks.fits;

        return fetch(SB + '/rest/v1/route_submissions', {
          method: 'POST',
          headers: headers({ 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
          body: JSON.stringify(row)
        });
      })
      .then(function (r) {
        if (!r.ok) return r.text().then(function (t) { throw new Error(t || 'save'); });
        $('form').hidden = true;
        $('thanks').hidden = false;
        $('thanks').scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
      .catch(function (err) {
        var m = String(err && err.message || '');
        if (m === 'photo') {
          problem('The photographs would not upload. That is usually a patchy connection - try pressing send again.');
        } else {
          problem('That did not save, and nothing has been sent. Try again in a moment, and if it keeps happening email hello@bridlenav.com and we will take the route that way.');
        }
      });
  });
})();
</script>
</body>
</html>
